# ---------------------------------------------------------------------------
# Weather-Aware Truck Routing - environment variable NAMES only.
# Copy to `.env` and fill in locally. NEVER commit a populated `.env`.
#
# NOTHING in the project requires a value here: the default providers are
# `fixtures` (offline) and Open-Meteo (no key). The full test suite passes
# with no credentials at all. A TomTom key only enables live routing.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend origin allowed to call the API (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Routing + geocoding provider ---
# Supported values: tomtom | fixtures
# `fixtures` runs fully offline with deterministic synthetic data.
ROUTING_PROVIDER=fixtures
GEOCODING_PROVIDER=fixtures
TOMTOM_API_KEY=

# --- Weather provider. Supported values: open-meteo | fixtures ---
# Open-Meteo requires no API key for non-commercial use.
WEATHER_PROVIDER=open-meteo

# --- Weather-map overlays on the map (optional) ---
# Enables GET /api/v1/weather-tiles/... which proxies OpenWeatherMap raster
# tiles (precipitation, clouds, wind, temperature) so the key stays on the
# server. Leave empty to hide the overlay controls. Route analysis does not
# use this key.
OPENWEATHERMAP_API_KEY=

# --- Provider response caching (seconds). Optional; defaults shown. ---
# In-process LocMemCache is used; no Redis or broker is required.
CACHE_TTL_GEOCODING=2592000
CACHE_TTL_ROUTING=600
CACHE_TTL_WEATHER=1800
CACHE_TTL_WEATHER_TILES=600
CACHE_TTL_CONDITIONS=600

# --- Optional AI route rationale (Milestone 9) ---
ENABLE_AI_RATIONALE=false
ANTHROPIC_API_KEY=
