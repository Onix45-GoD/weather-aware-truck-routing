# ---------------------------------------------------------------------------
# Weather-Aware Truck Routing - environment variable NAMES only.
# Copy to `.env` and fill in locally. NEVER commit a populated `.env`.
#
# Milestone 1 (domain core) requires NONE of these values.
# They are declared here so later milestones have a documented contract.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend origin allowed to call the API (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Routing + geocoding provider (Milestone 2) ---
# Supported values: tomtom | here | fixtures
ROUTING_PROVIDER=fixtures
GEOCODING_PROVIDER=fixtures
TOMTOM_API_KEY=
HERE_API_KEY=

# --- Weather provider (Milestone 2). Open-Meteo needs no key. ---
WEATHER_PROVIDER=open-meteo

# --- Cache (Milestone 3). Optional; falls back to in-memory. ---
CACHE_URL=

# --- Optional AI route rationale (Milestone 9) ---
ENABLE_AI_RATIONALE=false
ANTHROPIC_API_KEY=
